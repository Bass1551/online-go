@echo off
chcp 65001 >nul
title 🏯 Go Online - เซิร์ฟเวอร์เล่นข้ามอินเทอร์เน็ต (Global Online)
echo ======================================================================
echo    🏯 กำลังเริ่มต้นเกมหมากล้อมออนไลน์ สำหรับเล่นกับเพื่อน/แฟนคนละที่
echo ======================================================================
echo.
cd /d "%~dp0"

echo [1/2] เริ่มต้นระบบเซิร์ฟเวอร์เกม...
start "Go Server" /b node server/server.js
timeout /t 2 >nul

echo.
echo [2/2] สร้างลิงก์สาธารณะ (Cloudflare Global Tunnel)...
echo.
echo ======================================================================
echo  👉 ด้านล่างนี้จะมีลิงก์ https://...trycloudflare.com ปรากฏขึ้นมา
echo  👉 ให้คัดลอกลิงก์นั้นส่งให้เพื่อนหรือแฟนใน LINE / Messenger
echo     เปิดเล่นบนมือถือ (4G/5G) หรือคอมพิวเตอร์จากที่ไหนก็ได้ในโลกทันที!
echo ======================================================================
echo.

.\cloudflared.exe tunnel --url http://localhost:3000
pause
